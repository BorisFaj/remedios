FROM python:3.10-slim

ENV VENV=/remedios/.venv

# Dependencias base y ffmpeg para manejar audio
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    gcc \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /remedios

# Copiar requirements primero para cache
COPY requirements.txt requirements_audio.txt ./

# Crear venv e instalar dependencias en modo CPU
RUN python3 -m venv $VENV \
    && $VENV/bin/pip install --upgrade pip setuptools \
    && $VENV/bin/pip install --no-cache-dir -r server_requirements.txt \
    && $VENV/bin/pip install --no-cache-dir -r requirements_audio.txt \
    && $VENV/bin/pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Copiar código
COPY .. .

ENV PATH="/remedios/.venv/bin:${PATH}"

# Ejecutar servicio HTTP de remeaudio
CMD ["/remedios/.venv/bin/python", "-m", "remeaudio_service"]
