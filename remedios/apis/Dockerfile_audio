FROM python:3.10-slim

ARG APP_SRC=.
ENV VENV=/app/remedios/.venv
ENV PYTHONPATH=/app

# Dependencias base y ffmpeg para manejar audio
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    cmake \
    git \
    netcat-openbsd \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements primero para cache (APP_SRC=remedios si el contexto es raíz)
COPY ${APP_SRC}/apis/requirements.txt ${APP_SRC}/apis/requirements_audio.txt ./remedios/

# Crear venv e instalar dependencias en modo CPU
RUN python3 -m venv $VENV \
    && $VENV/bin/pip install --upgrade pip setuptools \
    && $VENV/bin/pip install --no-cache-dir -r remedios/requirements.txt \
    && $VENV/bin/pip install --no-cache-dir -r remedios/requirements_audio.txt

# Construir binario CLI de whisper.cpp (CPU)
RUN git clone --depth 1 --branch v1.7.1 https://github.com/ggerganov/whisper.cpp.git /tmp/whisper.cpp \
    && cd /tmp/whisper.cpp \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF \
    && cmake --build build -j \
    && (cp /tmp/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whispercpp-cli || cp /tmp/whisper.cpp/build/bin/whisper /usr/local/bin/whispercpp-cli || cp /tmp/whisper.cpp/build/bin/main /usr/local/bin/whispercpp-cli) \
    && (cp /tmp/whisper.cpp/build/bin/whisper-server /usr/local/bin/whisper-server || true) \
    && find /tmp/whisper.cpp/build -type f -name 'lib*.so*' -exec cp {} /usr/local/lib/ \; \
    && ldconfig \
    && rm -rf /tmp/whisper.cpp

# Copiar código de la app conservando la ruta del paquete
COPY ${APP_SRC}/ /app/remedios
WORKDIR /app
ENV PATH="/app/remedios/.venv/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# Arranque supervisado en Python
ENTRYPOINT ["/app/remedios/.venv/bin/python", "-m", "remedios.apis.audio_launcher"]
