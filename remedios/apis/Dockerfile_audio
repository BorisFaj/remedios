FROM python:3.10-slim

ENV VENV=/app/remedios/.venv
ENV PIP_NO_BINARY=whispercpp
ENV PYTHONPATH=/app

# Dependencias base y ffmpeg para manejar audio
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    cmake \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements primero para cache (contexto ./remedios)
COPY apis/requirements.txt apis/requirements_audio.txt ./remedios/

# Crear venv e instalar dependencias en modo CPU
RUN python3 -m venv $VENV \
    && $VENV/bin/pip install --upgrade pip setuptools \
    && $VENV/bin/pip install --no-cache-dir -r remedios/requirements.txt \
    && $VENV/bin/pip install --no-cache-dir -r remedios/requirements_audio.txt \
    && PIP_NO_BINARY=whispercpp $VENV/bin/pip install --force-reinstall --no-cache-dir --no-binary whispercpp whispercpp

# Copiar código de la app (todo el contexto ./remedios) conservando la ruta del paquete
COPY . /app/remedios

WORKDIR /app
ENV PATH="/app/remedios/.venv/bin:${PATH}"

# Ejecutar servicio HTTP de remeaudio
CMD ["/app/remedios/.venv/bin/python", "-m", "remedios.apis.audio_service"]
