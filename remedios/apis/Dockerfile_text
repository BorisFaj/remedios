FROM python:3.10-slim

ENV POETRY_VENV=/app/remedios/.venv

# Instalar dependencias básicas (build deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Copiar solo requirements para aprovechar cache (contexto ./remedios)
WORKDIR /app
COPY apis/requirements.txt apis/requirements_text.txt ./remedios/

# Crear entorno virtual e instalar deps
RUN python3 -m venv $POETRY_VENV \
    && $POETRY_VENV/bin/pip install --upgrade pip setuptools \
    && $POETRY_VENV/bin/pip install --no-cache-dir -r remedios/requirements.txt \
    && $POETRY_VENV/bin/pip install --no-cache-dir -r remedios/requirements_text.txt

# Copiar código
COPY . /app/remedios

WORKDIR /app/remedios

# Ejecutar
CMD ["/app/remedios/.venv/bin/python", "-m", "remetext_service"]
